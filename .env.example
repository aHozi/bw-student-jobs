# Copy to .env and fill in. Never commit .env.

# Required secrets APP_JWT_SECRET and APP_STORAGE_KEY are appended by the setup
# commands in the README ("Open in Cursor and run"). Do not commit .env.

# Database password (used by db and backend)
DB_PASSWORD=bwjobs

# Comma-separated e-mails that become admins on registration (the first account is always admin)
APP_ADMIN_EMAILS=

# Job sources
APP_SOURCE_EMAIL_ENABLED=true
APP_SOURCE_BA_ENABLED=true
# Free key from https://developer.adzuna.com (leave empty to disable Adzuna)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Company career-page scanning (the original source, off by default)
APP_SCAN_ENABLED=false
APP_SEED_ENABLED=false
APP_SCAN_WORKERS=4
# Identify your crawler honestly, with a contact URL or e-mail
APP_SCAN_USER_AGENT=BWStudentJobsBot/0.1 (+https://your-domain.example/bot; contact you@your-domain.example)

# AI (optional - AI match scores, CV tailoring, cover letters)
# auto = Claude if ANTHROPIC_API_KEY is set, otherwise Gemini if GEMINI_API_KEY is set
AI_PROVIDER=auto
# Google Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
APP_AI_DAILY_LIMIT=60
# Ask Claude to classify language requirements when rules find nothing (costs API calls)
APP_AI_LANGUAGE_FALLBACK=false
